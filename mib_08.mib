    kgmTimingPlanTable  OBJECT-TYPE
        SYNTAX              SEQUENCE OF kgmTimingPlanEntry
        ACCESS              not-accessible
        STATUS              mandatory
        DESCRIPTION "<Definition> 
                            <TableType> static
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.7.2"
        ::= { kgmTimingPlan 2 }
--1.7.2.1 kgmTimingPlanEntry
    kgmTimingPlanEntry  OBJECT-TYPE
        SYNTAX              kgmTimingPlanEntry
        ACCESS              not-accessible
        STATUS              mandatory
        DESCRIPTION "<Definition>  
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.7.2.1
                            <Unit> " 
    INDEX                   {  kgmTimingPlanNumber, kgmPhaseNumber }
    ::= { kgmTimingPlanTable 1 }

    kgmTimingPlanEntry ::= SEQUENCE {
