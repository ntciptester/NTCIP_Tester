		kgmPhaseNumber							INTEGER,
		kgmStaticPhaseTime						INTEGER,
		kgmPhaseMax1							INTEGER,
    }
	
--1.7.2.1.1 kgmTimingNumber
    kgmTimingPlanNumber OBJECT-TYPE
        SYNTAX              INTEGER (1..255)
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition> Max KGM Timing parametresini aşamaz.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.7.2.1.1
                            <Unit>  "
        ::= { kgmTimingPlanEntry 1 }
		
--1.7.2.1.2 kgmPhaseNumber
    kgmPhaseNumber   OBJECT-TYPE
        SYNTAX       		INTEGER (1..255)	
