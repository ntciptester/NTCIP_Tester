                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.7.2.1.2
                            <Unit> "
        ::= { kgmTimingPlanEntry 2} 
--1.7.2.1.3 kgmStaticPhaseTime
    kgmStaticPhaseTime  OBJECT-TYPE
        SYNTAX              INTEGER (1..255)	
