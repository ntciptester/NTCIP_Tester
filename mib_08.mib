							<Unit> phase"
		::= { kgmTrCoordEntry 8 }
		
--1.4.5.1.9 kgmTrCoordPhase02minDuration		
	kgmTrCoordPhase02minDuration OBJECT-TYPE
		SYNTAX                   INTEGER (0..255)
		ACCESS                   read-write
		STATUS                   mandatory
		DESCRIPTION "<Definition> Yesil dalga uygulamasi icin fazin minimum isletilecek
