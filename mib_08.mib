--1.8 kgmUnitParameter
--1.8.1 kgmUnitControlMode
	kgmUnitControlMode  OBJECT-TYPE
    SYNTAX              INTEGER {
                            flash (0),
                            dark (1),
                            timeBase (2),
                            service (3),
                        } 
    ACCESS              read-write
    STATUS              mandatory
    DESCRIPTION "<Definition> Sistem genelinin hangi moda bagli calistigini gosterir.
                        flash (0)  : Sistem flash modunda
                        dark(1)    : Sistem cikislari kapali
                        timeBase(2): Sistem zaman tablosuna bagli calisiyor 
                        service(3) : Sistem servis modunda. Bu modun detaylari icin cihaz manueline bakilir.
                        <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.8.1
                        <Unit>  "
    ::= { kgmUnitParameter 1 }
--1.8.2 kgmAlarmStatus1
	kgmAlarmStatus1  OBJECT-TYPE
    SYNTAX              INTEGER (0-255)
    ACCESS              read-only
    STATUS              mandatory
    DESCRIPTION "<Definition> Alarm durum maskesi, detaylar:
                             Bit = 0 Pasif
                             Bit = 1 Aktif
                             Bit 7 : Reserved
                             Bit 6 : Door State
                             Bit 5 : Undesired Ch Failure
                             Bit 4 : All Ch Failure
                             Bit 3 : Pedestrian Detector
                             Bit 2 : Vehicle Detector
                             Bit 1 : Driver
                             Bit 0 : PwrLine
                        <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.8.2
                        <Unit>  "
    ::= { kgmUnitParameter 2 }
--1.8.3 kgmMinWalkPlusPedClear
	kgmMinWalkPlusPedClear  OBJECT-TYPE
    SYNTAX              INTEGER (0-255)
    ACCESS              read-only
    STATUS              mandatory
    DESCRIPTION "<Definition> Minimum walk ve Pedestrian Clearance parametrelerinin toplamının
							  minimum olabileceği değerdir.
                        <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.8.3
                        <Unit>  "
    ::= { kgmUnitParameter 3 }
		
END