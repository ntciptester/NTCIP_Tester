	kgmTrCoordPhaseId01 OBJECT-TYPE
		SYNTAX          INTEGER (0..255)
		ACCESS          read-write
		STATUS          mandatory
		DESCRIPTION "<Definition> Yesil dalga faz numarasi. Yesil dalga uygulamasi
							belirtilen faz referans alinarak yapilir.
							<Object Identifier> 1.3.6.1.4.1.59873.4.2.1.4.5.1.4
							<Unit> phase"
		::= { kgmTrCoordEntry 4 }
		
