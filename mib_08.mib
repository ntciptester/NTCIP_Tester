		kgmTrCoordReturnPhaseId02      INTEGER
	}
	
--1.4.5.1.1 kgmTrCoordNumber		
	kgmTrCoordNumber OBJECT-TYPE
		SYNTAX       INTEGER (1..255)
		ACCESS       read-only
		STATUS       mandatory
		DESCRIPTION "<Definition> Koordinasyon tablo indeks numarasi
                            kgmMaxTrCoords degerini asamaz.
							<Object Identifier> 1.3.6.1.4.1.59873.4.2.1.4.5.1.1
							<Unit> coord"
		::= { kgmTrCoordEntry 1 }
		
--1.4.5.1.2 kgmTrCoordCycleTime		
	kgmTrCoordCycleTime OBJECT-TYPE
		SYNTAX          INTEGER (0..65535)
		ACCESS          read-write
		STATUS          mandatory
		DESCRIPTION "<Definition> Yesil dalga devre suresinin saniye cinsinden degeridir.
							<Object Identifier> 1.3.6.1.4.1.59873.4.2.1.4.5.1.2
							<Unit> second"
		::= { kgmTrCoordEntry 2 }
		
--1.4.5.1.3 kgmTrCoordGeneralOffsetTime		
	kgmTrCoordGeneralOffsetTime OBJECT-TYPE
		SYNTAX                  INTEGER (0..65535)
		ACCESS                  read-write
		STATUS                  mandatory
		DESCRIPTION "<Definition> Yesil dalga uygulamasi icin Referans devre baslangic ofseti
							degeri. Ofset degeri gece 00:00:00 ani itibari ile saniye
							cinsinden ifade edilir.
							<Object Identifier> 1.3.6.1.4.1.59873.4.2.1.4.5.1.3
							<Unit> second"
		::= { kgmTrCoordEntry 3 }
		
