--Karayollari NTCIP Protokolu
--****************************************************************************
-- Filename:    tc_kgm_v0.8.mib
-- Version:     0.8
-- Description: This MIB defines various globally applicable objects
-- Source:      TC KGM Custom Mib Document
-- MIB Revision History:
-- 05/04/24     Created file form Word .Doc file.
--              Fixed syntax errors.
-- 24/12/24     Removed unused imports.
--              Fixed enum values
--              Fixed naming issues
--              Added kgmMaxSubjunctions and edited OIDs accordingly.
-- 25/12/24     Removed unnecessarily used kgmTrffcLghtFaultChannelNumber.
--              Changed kgmTrPatternSpecParamTableIndex syntax from INTEGER to OBJECT IDENTIFIER
--              Changed kgmTrPatternSpecParamTableIndex status to optional
-- 22/07/25     Renamed kgmDedectorModuleStatus to kgmDetectorModuleStatus
--              Renamed kgmMaxSignalState to kgmMaxSignalStates
--              Fixed entry indexes declared as not-accessible (should've been read-only)
--              Fixed text alignment issues
-- 02/09/25     Timing plan table added
-- 				Signal state table modified
-- 				kgmUnitParameter added
-- 04/09/25
--kgmMinWalkPlusPedClear parameter added



TC-KGM-NTCIP DEFINITIONS ::= BEGIN
    --For the purpose of this section, the following OBJECT IDENTIFIERS are used:
    IMPORTS
    OBJECT-TYPE
        FROM RFC-1212
    Counter, enterprises
        FROM RFC1155-SMI;

    kgm                            OBJECT IDENTIFIER ::= { enterprises 59873 }
    kgmTransportation              OBJECT IDENTIFIER ::= { kgm 4 }
    kgmDevices                     OBJECT IDENTIFIER ::= { kgmTransportation 2 }
    kgmAsc                         OBJECT IDENTIFIER ::= { kgmDevices 1 }

    kgmModuleErrorStatus           OBJECT IDENTIFIER ::= { kgmAsc 1 }
    kgmChannelFault                     OBJECT IDENTIFIER ::= { kgmAsc 2 }
    kgmSignalState                 OBJECT IDENTIFIER ::= { kgmAsc 3 }
    kgmTrPattern                   OBJECT IDENTIFIER ::= { kgmAsc 4 }
    kgmDetector                    OBJECT IDENTIFIER ::= { kgmAsc 5 }
    kgmUser                        OBJECT IDENTIFIER ::= { kgmAsc 6 }
    kgmTimingPlan                  OBJECT IDENTIFIER ::= { kgmAsc 7 }
    kgmUnitParameter               OBJECT IDENTIFIER ::= { kgmAsc 8 }

--1.1 kgmModuleErrorStatus
--1.1.1 kgmMaxDriverModuleGroupStatus
    kgmMaxDriverModuleGroupStatus OBJECT-TYPE 
        SYNTAX                    INTEGER (1..255)
        ACCESS                    read-only
        STATUS                    mandatory
        DESCRIPTION "<Definition> Maksimum surucu modul grup durum sayisi.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.1.1"
        ::= { kgmModuleErrorStatus 1 }
--1.1.2 kgmDriverModuleGroupStatus
    kgmDriverModuleGroupStatus OBJECT-TYPE
        SYNTAX              INTEGER (0..65535)
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition>Surucu modulu durum bilgisi yer alir.
		                    Modul grup numarasina gore 16 modul bilgisini icerir.
                            Bit = 0 ise modul calismiyor.
                            Bit = 1 ise modul calisiyor.
                            Bit 15: Module 16
                            Bit 14: Module 15
                            Bit 13: Module 14
                            Bit 12: Module 13
                            Bit 11: Module 12
                            Bit 10: Module 11
                            Bit 9 : Module 10
                            Bit 8 : Module 9
                            Bit 7 : Module 8 
                            Bit 6 : Module 7 
                            Bit 5 : Module 6 
                            Bit 4 : Module 5 
                            Bit 3 : Module 4 
                            Bit 2 : Module 3 
                            Bit 1 : Module 2 
                            Bit 0 : Module 1
                            <Object Identifier>1.3.6.1.4.1.59873.4.2.1.1.2"
        ::= { kgmModuleErrorStatus 2 }

--1.2 kgmChannelFault
--1.2.1 kgmMaxTrffcLghtFltStatusGroups
    kgmMaxTrffcLghtFltStatusGroups OBJECT-TYPE 
        SYNTAX                     INTEGER (0..255)
        ACCESS                     read-only
        STATUS                     mandatory
        DESCRIPTION "<Definition>Maksimum kanal ariza durum sayisi.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.2.1"
        ::= { kgmChannelFault 1 }
--1.2.2 kgmTrffcLghtFltStatusTable
    kgmTrffcLghtFltStatusTable OBJECT-TYPE
        SYNTAX                 SEQUENCE OF KgmTrffcLghtFltStatusEntry 
        ACCESS                 not-accessible
        STATUS                 mandatory
        DESCRIPTION "<Definition> Lamba grubunun ariza durum tablosu
                            <TableType> static
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.2.2"
        ::= { kgmChannelFault 2 }
--1.2.2.1 kgmTrffcLghtFltStatusEntry
    kgmTrffcLghtFltStatusEntry OBJECT-TYPE 
        SYNTAX                 KgmTrffcLghtFltStatusEntry 
        ACCESS                 not-accessible
        STATUS                 mandatory
        DESCRIPTION "<Definition> Lamba grubunun ariza durum entry'si
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.2.2.1
                            <Unit> "
        INDEX               { kgmTrffcLghtFltStatusNumber }
        ::= { kgmTrffcLghtFltStatusTable 1 }

    KgmTrffcLghtFltStatusEntry ::= SEQUENCE { 
        kgmTrffcLghtFltStatusNumber   INTEGER, 
        kgmTrffcLghtFltGreenStatus    INTEGER, 
        kgmTrffcLghtFltYellowStatus   INTEGER, 
        kgmTrffcLghtFltRedStatus      INTEGER
    }
--1.2.2.1.1 kgmTrffcLghtFltStatusNumber
    kgmTrffcLghtFltStatusNumber OBJECT-TYPE
        SYNTAX                  INTEGER (1..255) 
        ACCESS                  read-only
        STATUS                  mandatory 
        DESCRIPTION "<Definition>ariza tablosu id bilgisi
                            kgmMaxTrffcLghtFltStatusGroups degerini asamaz.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.2.2.1.1 
                            <Unit> "
        ::= { kgmTrffcLghtFltStatusEntry 1 }
--1.2.2.1.3 kgmTrffcLghtFltGreenStatus
    kgmTrffcLghtFltGreenStatus OBJECT-TYPE
        SYNTAX                 INTEGER (0..255)
        ACCESS                 read-only
        STATUS                 mandatory
        DESCRIPTION "<Definition>
                            0: ariza yok
                            Bit 1: Lamba arizasi(Kritik olmayan) 
                            Bit 2: Kritik lamba arizasi
                            Bit 3: Tum lamba arizasi
                            Bit 4: Cakisma var
                            Bit 5: Kisa devre arizasi (Sinyal cikis anahtari kisa devre / sinyal grup cikisi kisa devre veya haricen kablo kisa devresi)
                            Bit 6: Sinyal cikis anahtari acik devre / sinyal grup cikisi acik devre
                            Bit 7: Rez.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.2.2.1.2
                            <Unit>"
        ::= { kgmTrffcLghtFltStatusEntry 2 }
--1.2.2.1.4 kgmTrffcLghtFltYellowStatus
    kgmTrffcLghtFltYellowStatus OBJECT-TYPE
        SYNTAX                  INTEGER (0..255)
        ACCESS                  read-only
        STATUS                  mandatory
        DESCRIPTION "<Definition>
                            1 Byte
                            Bit 0: ariza yok
                            Bit 1: Lamba arizasi(Kritik olmayan) Bit 2: Kritik lamba arizasi
                            Bit 3: Tum lamba arizasi
                            Bit 4: Cakisma var
                            Bit 5: Kisa devre arizasi (Sinyal cikis anahtari kisa devre / sinyal grup cikisi kisa devre veya haricen kablo kisa devresi)
                            Bit 6: Sinyal cikis anahtari acik devre / sinyal grup cikisi acik devre
                            Bit 7: Rez.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.2.2.1.3
                            <Unit>"
        ::= { kgmTrffcLghtFltStatusEntry 3 }
--1.2.2.1.5 kgmTrffcLghtFltRedStatus
    kgmTrffcLghtFltRedStatus OBJECT-TYPE
        SYNTAX 				 INTEGER (0..255)
        ACCESS 				 read-only
        STATUS 				 mandatory
        DESCRIPTION "<Definition>
                            1 Byte
                            Bit 0: ariza yok
                            Bit 1: Lamba arizasi(Kritik olmayan) Bit 2: Kritik lamba arizasi
                            Bit 3: Tum lamba arizasi
                            Bit 4: Cakisma var
                            Bit 5: Kisa devre arizasi (Sinyal cikis anahtari kisa devre / sinyal grup cikisi kisa devre veya haricen kablo kisa devresi)
                            Bit 6: Sinyal cikis anahtari acik devre / sinyal grup cikisi acik devre
                            Bit 7: Rez.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.2.2.1.4
                            <Unit>"
        ::= { kgmTrffcLghtFltStatusEntry 4 }
--1.2.3 kgmMaxChannelErrorFlagsGroups
    kgmMaxChannelErrorFlagsGroups OBJECT-TYPE
        SYNTAX 				INTEGER (0..255)
        ACCESS 				read-only
        STATUS 				mandatory
        DESCRIPTION "<Definition>
                            Maksimum kanal ariza durum sayisi.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.2.3"
        ::= { kgmChannelFault 3 }
--1.2.4 kgmChannelErrorFlagsTable
    kgmChannelErrorFlagsTable OBJECT-TYPE
        SYNTAX 				  SEQUENCE OF KgmChannelErrorFlagsEntry
        ACCESS 				  not-accessible
        STATUS 				  mandatory
        DESCRIPTION "<Definition> Kanal hata durum bayraklari grup tablosu. 
                            Tabloda ki her bir satir 8li gruplar halinde ifade edilebilecek sekilde organize edilmistir.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.2.4
                            <Unit> group"
        ::= { kgmChannelFault 4 }
--1.2.4.1 kgmChannelErrorFlagsEntry
    kgmChannelErrorFlagsEntry OBJECT-TYPE
        SYNTAX 				  KgmChannelErrorFlagsEntry
        ACCESS 				  not-accessible
        STATUS 				  mandatory     
        DESCRIPTION "<Definition> 8li gruplar halinde kanal hata durum bayraklari.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.2.4.1 "
        INDEX				{ kgmErrorFlagsGroupNumber }
        ::= { kgmChannelErrorFlagsTable 1 }

    KgmChannelErrorFlagsEntry ::= SEQUENCE {
        kgmErrorFlagsGroupNumber   INTEGER,
        kgmRedLampAllFailure       INTEGER,
        kgmGreenLampAllFailure     INTEGER,
        kgmYellowLampAllFailure    INTEGER,
        kgmUndesiredRedSignal      INTEGER,
        kgmUndesiredGreenSignal    INTEGER,
        kgmUndesiredYellowSignal   INTEGER
    }
--1.2.4.1.1 kgmErrorFlagsGroupNumber
    kgmErrorFlagsGroupNumber OBJECT-TYPE 
        SYNTAX               INTEGER (0..255)
        ACCESS               read-only
        STATUS               mandatory
        DESCRIPTION "<Definition> Ilgili tablo satirinda ki Kanal hata bayraklari grup numarasi.
                            kgmMaxChannelErrorFlagsGroups degerini asamaz.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.2.4.1.1
                            <Unit>"
        ::= { kgmChannelErrorFlagsEntry 1 }
--1.2.4.1.2 kgmRedLampAllFailure
    kgmRedLampAllFailure    OBJECT-TYPE 
        SYNTAX              INTEGER (0..255)
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition>
                            Kanal Kirmizi ariza durumlari
                            Bit=1 ise ilgili kanal kopuk flaman arizasi var.
                            Bit=0 ise ilgili kanal arizasi yok.
                            Bit 7: Channel# = (errorgroupNumber * 8) 
                            Bit 6: Channel# = (errorgroupNumber * 8) - 1 
                            Bit 5: Channel# = (errorgroupNumber * 8) - 2 
                            Bit 4: Channel# = (errorgroupNumber * 8) - 3 
                            Bit 3: Channel# = (errorgroupNumber * 8) - 4 
                            Bit 2: Channel# = (errorgroupNumber * 8) - 5 
                            Bit 1: Channel# = (errorgroupNumber * 8) - 6 
                            Bit 0: Channel# = (errorgroupNumber * 8) - 7
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.2.4.1.2
                            <Unit>"
        ::= { kgmChannelErrorFlagsEntry 2 }
--1.2.4.1.3 kgmGreenLampAllFailure
    kgmGreenLampAllFailure  OBJECT-TYPE 
        SYNTAX              INTEGER (0..255)
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition>
                            Kanal Yesil ariza durumlari
                            Bit=1 ise ilgili kanal kopuk flaman arizasi var.
                            Bit=0 ise ilgili kanal arizasi yok.
                            Bit 7: Channel# = (errorgroupNumber * 8)
                            Bit 6: Channel# = (errorgroupNumber * 8) - 1
                            Bit 5: Channel# = (errorgroupNumber * 8) - 2
                            Bit 4: Channel# = (errorgroupNumber * 8) - 3
                            Bit 3: Channel# = (errorgroupNumber * 8) - 4
                            Bit 2: Channel# = (errorgroupNumber * 8) - 5
                            Bit 1: Channel# = (errorgroupNumber * 8) - 6 
                            Bit 0: Channel# = (errorgroupNumber * 8) - 7
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.2.4.1.3
                            <Unit>  "
        ::= { kgmChannelErrorFlagsEntry 3 }
--1.2.4.1.4 kgmYellowLampAllFailure
    kgmYellowLampAllFailure OBJECT-TYPE 
        SYNTAX              INTEGER (0..255)
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition>
                            Kanal Sari ariza durumlari
                            Bit=1 ise ilgili kanalda kopuk flaman arizasi var. 
                            Bit=0 ise ilgili kanal arizasi yok.
                            Bit 7: Channel# = (errorgroupNumber * 8) 
                            Bit 6: Channel# = (errorgroupNumber * 8) - 1
                            Bit 5: Channel# = (errorgroupNumber * 8) - 2
                            Bit 4: Channel# = (errorgroupNumber * 8) - 3
                            Bit 3: Channel# = (errorgroupNumber * 8) - 4
                            Bit 2: Channel# = (errorgroupNumber * 8) - 5
                            Bit 1: Channel# = (errorgroupNumber * 8) - 6
                            Bit 0: Channel# = (errorgroupNumber * 8) - 7
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.2.4.1.4
                            <Unit>  "
        ::= { kgmChannelErrorFlagsEntry 4 }
--1.2.4.1.5 kgmUndesiredRedSignal
    kgmUndesiredRedSignal   OBJECT-TYPE 
        SYNTAX              INTEGER (0..255)
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition>
                            Kanal Istemsiz Kirmizi sinyal durumlari
                            Bit=1 ise ilgili kanalda kopuk flaman arizasi var. 
                            Bit=0 ise ilgili kanal arizasi yok.
                            Bit 7: Channel# = (errorgroupNumber * 8) 
                            Bit 6: Channel# = (errorgroupNumber * 8) - 1
                            Bit 5: Channel# = (errorgroupNumber * 8) - 2
                            Bit 4: Channel# = (errorgroupNumber * 8) - 3
                            Bit 3: Channel# = (errorgroupNumber * 8) - 4
                            Bit 2: Channel# = (errorgroupNumber * 8) - 5
                            Bit 1: Channel# = (errorgroupNumber * 8) - 6
                            Bit 0: Channel# = (errorgroupNumber * 8) - 7
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.2.4.1.5
                            <Unit>  "
        ::= { kgmChannelErrorFlagsEntry 5 }
--1.2.4.1.6 kgmUndesiredGreenSignal
    kgmUndesiredGreenSignal OBJECT-TYPE 
        SYNTAX              INTEGER (0..255)
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition>
                            Kanal Istemsiz yesil sinyal durumlari
                            Bit=1 ise ilgili kanalda istemsiz sinyal vardir.
                            Bit=0 ise ilgili kanalda istemsiz sinyal yoktur.
                            Bit 7: Channel# = (errorgroupNumber * 8)
                            Bit 6: Channel# = (errorgroupNumber * 8) - 1
                            Bit 5: Channel# = (errorgroupNumber * 8) - 2
                            Bit 4: Channel# = (errorgroupNumber * 8) - 3
                            Bit 3: Channel# = (errorgroupNumber * 8) - 4
                            Bit 2: Channel# = (errorgroupNumber * 8) - 5
                            Bit 1: Channel# = (errorgroupNumber * 8) - 6
                            Bit 0: Channel# = (errorgroupNumber * 8) - 7
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.2.4.1.6
                            <Unit>  "
        ::= { kgmChannelErrorFlagsEntry 6 }
--1.2.4.1.7 kgmUndesiredYellowSignal
    kgmUndesiredYellowSignal  OBJECT-TYPE
        SYNTAX                INTEGER (0..255)
        ACCESS                read-only
        STATUS                mandatory
        DESCRIPTION "<Definition> 
                            Kanal Istemsiz sari sinyal durumlari
                            Bit=1 ise ilgili kanalda istemsiz sinyal vardir.
                            Bit=0 ise ilgili kanalda istemsiz sinyal yoktur.
                            Bit 7: Channel# = (errorgroupNumber * 8)
                            Bit 6: Channel# = (errorgroupNumber * 8) - 1
                            Bit 5: Channel# = (errorgroupNumber * 8) - 2
                            Bit 4: Channel# = (errorgroupNumber * 8) - 3
                            Bit 3: Channel# = (errorgroupNumber * 8) - 4
                            Bit 2: Channel# = (errorgroupNumber * 8) - 5
                            Bit 1: Channel# = (errorgroupNumber * 8) - 6
                            Bit 0: Channel# = (errorgroupNumber * 8) - 7
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.2.4.1.7
                            <Unit>  "
        ::= { kgmChannelErrorFlagsEntry 7 }

--1.3 kgmSignalState
--1.3.1 kgmMaxSignalStates
    kgmMaxSignalStates      OBJECT-TYPE
        SYNTAX              INTEGER (1..255)
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition> 
                            Maksimum sinyal durum sayisina esittir. kgmSignalStateNumber maksimum degerini asamaz
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.3.1"
        ::= { kgmSignalState 1 }
--1.3.2 kgmSignalStateTable
    kgmSignalStateTable     OBJECT-TYPE
        SYNTAX              SEQUENCE OF KgmSignalStateEntry
        ACCESS              not-accessible
        STATUS              mandatory
        DESCRIPTION "<Definition> Sinyal durum tablosu 
                            <TableType> static
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.3.2"
        ::= { kgmSignalState 2 }
--1.3.2.1 kgmSignalStateEntry
    kgmSignalStateEntry     OBJECT-TYPE
        SYNTAX              KgmSignalStateEntry
        ACCESS              not-accessible
        STATUS              mandatory
        DESCRIPTION "<Definition> Sinyal durum tablo Entry'si   
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.3.2.1
                            <Unit> " 
        INDEX               { kgmSignalStateSubjunctionNo, kgmSignalStateNumber }
        ::= { kgmSignalStateTable 1 }

    KgmSignalStateEntry ::= SEQUENCE {
	    kgmSignalStateSubjunctionNo         INTEGER,
        kgmSignalStateNumber                INTEGER,
        kgmSignalStateUnitControlMode       INTEGER,
        kgmSignalStatePatternNo             INTEGER,
        kgmSignalStateExecMode	            INTEGER,
        kgmSignalStatePlanMode	            INTEGER,
        kgmSignalStateSequenceNumber        INTEGER,
        kgmSignalStateTimingPlanNumber      INTEGER,
        kgmSignalStateSplitNumber           INTEGER,
        kgmSignalStateActivePhases          OCTET STRING,
        kgmSignalStateTransitionFlags	    INTEGER,
        kgmSignalStateElapsedPhaseTimes     OCTET STRING,
		kgmTrPatternTimeToSyncPoint         INTEGER
    } 
--1.3.2.1.1 kgmSignalStateSubjunctionNo
    kgmSignalStateSubjunctionNo    OBJECT-TYPE
        SYNTAX              INTEGER (1..255)
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition> Alt kavşak numarası
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.3.2.1.1
                            <Unit>  "
        ::= { kgmSignalStateEntry 1 }
--1.3.2.1.2 kgmSignalStateNumber
    kgmSignalStateNumber    OBJECT-TYPE
        SYNTAX              INTEGER (1..255)
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition> Sinyal durum tablosu id bilgisi
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.3.2.1.2
                            <Unit>  "
        ::= { kgmSignalStateEntry 2 }
--1.3.2.1.3 kgmSignalStateUnitControlMode
	kgmSignalStateUnitControlMode  OBJECT-TYPE
    SYNTAX              INTEGER {
                            flash (0),
                            dark (1),
                            timeBase (2),
                            service (3),
                        } 
    ACCESS              read-only
    STATUS              mandatory
    DESCRIPTION "<Definition> Sistem genelinin hangi moda bagli calistigini gosterir.
                        flash (0)  : Sistem flash modunda
                        dark(1)    : Sistem cikislari kapali
                        timeBase(2): Sistem zaman tablosuna bagli calisiyor 
                        service(3) : Sistem servis modunda. Bu modun detaylari icin cihaz manueline bakilir.
                        <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.3.2.1.3
                        <Unit>  "
    ::= { kgmSignalStateEntry 3 }
--1.3.2.1.4 kgmSignalStatePatternNo
    kgmSignalStatePatternNo OBJECT-TYPE
        SYNTAX              INTEGER (1..255)
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition> Plan kapsaminda secili Pattern numarasidir. 
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.3.2.1.4
                            <Unit>  "
        ::= { kgmSignalStateEntry 4 } 
--1.3.2.1.5 kgmSignalStateExecMode
    kgmSignalStateExecMode  OBJECT-TYPE
        SYNTAX              INTEGER {
                                none (1),
                                init (2),
                                initialFlash (3),
                                program (4),
                                flash (5),
                                failFlash (6),
                                allYellow (7),
                                allRed (8),
                                allDark (9),
                                testOutputs (10),
                                programError (11),
                                testSignalPlan (12) 
                            } 
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition> Hangi modda oldugu bilgisini icerir.
                            Cihaz program modunda ise detayda hangi modda calistigi bilgisi kgmSignalStatePlanMode nesnesinden okunur.
                            None (1)
                            Init(2): Cihaz yeni acildi henuz cikislari surmeye baslamadi
                            InitialFlash(3): Cihaz yeni acilmis veya yapi degisikligi olmus ve baslangic flasi yapiyor.
                            Program(4): Cihaz haftalik plandaki duzene gore calisiyor.
                            Flash(5): Cihaz flas moduna zorlanmis
                            FailFlash(6): Cihaz arizi bir durumdan dolayi flas moduna gecmis
                            AllYellow(7): Tum cikislar sari
                            AllRed(8): Tum cikislar kirmizi
                            AllDark(9): Tum cikislar sonuk
                            TestOutputs(10): cikislarin lambalara dogru bir sekilde baglanip baglanmadigini kontrol 
                                etmek icin sira ile her bir cikisa yesil, sari, kirmizi, kirmizi sari renklerinin verilmesidir.
                            ProgramError(11): Sinyal programcisi tarafindan yuklenen sinyal planinda bir hata olmasi durumunda gecilen mod.
                            TestSignalPlan(12): Bu modda sinyal cikislari kapalidir. Diger her sey program modunda calismaktadir. 
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.3.2.1.5
                            <Unit>  "
        ::= { kgmSignalStateEntry 5 }
--1.3.2.1.6 kgmSignalStatePlanMode
    kgmSignalStatePlanMode  OBJECT-TYPE
        SYNTAX              INTEGER {
                                fixedPlan (1),
								actuated (2),
								centralAdaptive (3),
								flashing (4),
								dark (5),
								localAdaptive (6),
								extendedMode (7)
                            }
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition> 
                            FixedPlan	    (1): Multi Plan(sabit sureli), sensorler devre disidir.
											 Faz sureleri timing plan tablsunda belirtilen StaticTime parametresinden alinir.
							Actuated		(2): Kavsagin butun kollarinda sensor
											 bulunmaktadir. Sinyal planindaki butun fazlar acilmakta
											 ve talep olmasi durumunda max sureye kadar calistirilmaktadir.
							CentralAdaptive (3): Bu modda isletilen sure Planlari (Koordinasyon aktifse SplitTable, pasifse TimingPlan) 
											 ve SequenceTable kontrol merkez tarafından belirli araliklarla guncellenmektedir.
											 bagli fazlarin maximum sureye kadar esnetilebildigi dinamik calisma modudur.
							Flash	    	(4): Flasli calisma(Gece flasi gibi)
							Dark		    (5): Tum cikislar kapali.
							LocalAdaptive   (6): Bu modda plan sureleri ve faz siralari, fazlarin isletilip isletilmeyecegi 
												 lokalde cihaz tarafindan uretilmekte ve uygulanmaktadir.
							Extended Mode   (7): Cihazlarin destekledigi ek modlar icin uretici cihaz manueline birakilir.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.3.2.1.6
                            <Unit>  "
        ::= { kgmSignalStateEntry 6 }
--1.3.2.1.7 kgmSignalStateSequenceNumber
    kgmSignalStateSequenceNumber OBJECT-TYPE
        SYNTAX              INTEGER (1..255)
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition> Plan kapsaminda secili Sequence numarasidir.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.3.2.1.7
                            <Unit>  "
        ::= { kgmSignalStateEntry 7 }
--1.3.2.1.8 kgmSignalStateTimingPlanNumber
    kgmSignalStateTimingPlanNumber OBJECT-TYPE
        SYNTAX              INTEGER (1..255)
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition> Plan kapsaminda secili Timing Plan numarasidir.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.3.2.1.8
                            <Unit>  "
        ::= { kgmSignalStateEntry 8 }		
--1.3.2.1.9 kgmSignalStateSplitNumber
    kgmSignalStateSplitNumber OBJECT-TYPE
        SYNTAX              INTEGER (1..255)
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition> Plan kapsaminda secili Split numarasidir.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.3.2.1.9
                            <Unit>  "
        ::= { kgmSignalStateEntry 9 }	
--1.3.2.1.10 kgmSignalStateActivePhases
    kgmSignalStateActivePhases     OBJECT-TYPE
        SYNTAX              OCTET STRING
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition>  
                            Calismakta olan faz veya fazlar. 
							Her bir byte 8 adet faz bilgisi icermektedir. 
							Tum fazlari kapsayacak sekilde byte serileri Octet String olusturur. 
							Temsili bir byte degerinin icerigi asagidaki gibidir.
                            Bit=1 Aktif
                            Bit=0 Pasif
                            Bit 7: Phase# = (phaseGroupNumber * 8)
                            Bit 6: Phase# = (phaseGroupNumber * 8) - 1
                            Bit 5: Phase# = (phaseGroupNumber * 8) - 2
                            Bit 4: Phase# = (phaseGroupNumber * 8) - 3
                            Bit 3: Phase# = (phaseGroupNumber * 8) - 4
                            Bit 2: Phase# = (phaseGroupNumber * 8) - 5
                            Bit 1: Phase# = (phaseGroupNumber * 8) - 6
                            Bit 0: Phase# = (phaseGroupNumber * 8) - 7
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.3.2.1.10
                            <Unit>  "
        ::= { kgmSignalStateEntry 10 }
--1.3.2.1.11 kgmSignalStateTransitionFlags
    kgmSignalStateTransitionFlags OBJECT-TYPE
        SYNTAX                   OCTET STRING
        ACCESS                   read-only
        STATUS                   mandatory
        DESCRIPTION "<Definition>
							Gecis konumundaki faz veya fazlari belirtir.
							Her bir byte 8 adet faz bilgisi icermektedir. 
							Tum fazlari kapsayacak sekilde byte serileri Octet String olusturur. 
							Temsili bir byte degerinin icerigi asagidaki gibidir.
                            Bit=1 Gecis konumunda
                            Bit=0 Faz konumunda veya kapali konumda
                            Bit 7: Phase# = (phaseGroupNumber * 8)
                            Bit 6: Phase# = (phaseGroupNumber * 8) - 1
                            Bit 5: Phase# = (phaseGroupNumber * 8) - 2
                            Bit 4: Phase# = (phaseGroupNumber * 8) - 3
                            Bit 3: Phase# = (phaseGroupNumber * 8) - 4
                            Bit 2: Phase# = (phaseGroupNumber * 8) - 5
                            Bit 1: Phase# = (phaseGroupNumber * 8) - 6
                            Bit 0: Phase# = (phaseGroupNumber * 8) - 7
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.3.2.1.11
                            <Unit>  flag"
        ::= { kgmSignalStateEntry 11 }
--1.3.2.1.12 kgmSignalStateElapsedPhaseTimes
    kgmSignalStateElapsedPhaseTimes OBJECT-TYPE
        SYNTAX                OCTET STRING
        ACCESS                read-only
        STATUS                mandatory
        DESCRIPTION "<Definition> 
							Cevrim dahilinde isletilmis veya isletilmekte olan fazlarin sureleridir.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.3.2.1.12
                            <Unit>  second"
        ::= { kgmSignalStateEntry 12 }		
--1.3.2.1.13 kgmTrPatternTimeToSyncPoint
    kgmTrPatternTimeToSyncPoint OBJECT-TYPE
        SYNTAX                  INTEGER (0..255)
        ACCESS                  read-only
        STATUS                  mandatory
        DESCRIPTION "<Definition> 
							Senkronizasyon noktasinda olan saniye biriminden kalan sureyi belirtir.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.3.2.1.13
                            <Unit> second"
        ::= { kgmSignalStateEntry 13 }
--1.3.2.1.14 kgmSignalStateAlarmStatus1
	kgmSignalStateAlarmStatus1  OBJECT-TYPE
    SYNTAX              INTEGER (0-255)
    ACCESS              read-only
    STATUS              mandatory
    DESCRIPTION "<Definition> Alarm durum maskesi, detaylar:
                             Bit = 0 Pasif
                             Bit = 1 Aktif
                             Bit 7 : Reserved
                             Bit 6 : Door State
                             Bit 5 : Undesired Ch Failure
                             Bit 4 : All Ch Failure
                             Bit 3 : Pedestrian Detector
                             Bit 2 : Vehicle Detector
                             Bit 1 : Driver
                             Bit 0 : PwrLine
                        <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.3.2.1.14
                        <Unit>  "
    ::= { kgmSignalStateEntry 14 }
--1.3.3 kgmSignalPlanLastChangeTimes
    kgmSignalPlanLastChangeTimes OBJECT-TYPE
        SYNTAX                   Counter
        ACCESS                   read-only
        STATUS                   mandatory
        DESCRIPTION "<Definition> Sinyal planinin son degistirildigi zaman bilgisi 
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.3.3
                            <Unit> second"
        ::= { kgmSignalState 3 }
--1.4 kgmTrPattern
--1.4.1 kgmMaxSubjunctions
    kgmMaxSubjunctions      OBJECT-TYPE
        SYNTAX              INTEGER (1..255)
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition>Maksimum alt kavsak sayisina esittir.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.4.1"
        ::= { kgmTrPattern 1 }
--1.4.2 kgmMaxTrPatterns
    kgmMaxTrPatterns        OBJECT-TYPE
        SYNTAX              INTEGER (1..255)
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition>Maksimum pattern sayisina esittir.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.4.2"
        ::= { kgmTrPattern 2 }
--1.4.3 kgmTrPatternTable
    kgmTrPatternTable	    OBJECT-TYPE
        SYNTAX              SEQUENCE OF KgmTrPatternEntry
        ACCESS              not-accessible
        STATUS              mandatory
        DESCRIPTION "<Definition>Pattern parametrelerini iceren tablodur. Tablo satir
							sayisi kgmMaxSubjunctions * kgmMaxTrPatterns sayisina esittir.
							<TableType> static
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.4.3"
        ::= { kgmTrPattern 3 }
--1.4.3.1 kgmTrPatternEntry
    kgmTrPatternEntry       OBJECT-TYPE
        SYNTAX              KgmTrPatternEntry
        ACCESS              not-accessible
        STATUS              mandatory
        DESCRIPTION "<Definition>
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.4.3.1
                            <Unit> "
        INDEX { kgmSubjunctionNumber, kgmTrPatternNumber }
        ::= { kgmTrPatternTable 1 }

    KgmTrPatternEntry::= SEQUENCE {
        kgmSubjunctionNumber               INTEGER,
        kgmTrPatternNumber                 INTEGER,
        kgmTrPatternPriority               INTEGER,
        kgmTrPatternPlanMode               INTEGER,
        kgmTrPatternExtendedMode           INTEGER,  
        kgmTrPatternSequenceNumber         INTEGER,
        kgmTrPatternSplitNumber            INTEGER,
		kgmTrPatternTimingPlanNumber       INTEGER,
        kgmTrPatternCoordStatus            INTEGER,
        kgmTrPatternOutputSupervision      INTEGER,
        kgmTrPatternSpecParamTableIndex    INTEGER,
    }
--1.4.3.1.1 kgmSubjunctionNumber
    kgmSubjunctionNumber    OBJECT-TYPE
        SYNTAX              INTEGER (1..255)
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition> Sinyal programlama tablosu alt kavsak id numarasi.
                            kgmMaxSubjunctions degerini asamaz.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.4.3.1.1
                            <Unit>  "
        ::= { kgmTrPatternEntry 1 }
--1.4.3.1.2 kgmTrPatternNumber
    kgmTrPatternNumber      OBJECT-TYPE
        SYNTAX              INTEGER (1..255)
        ACCESS              read-only
        STATUS              mandatory
        DESCRIPTION "<Definition> Pattern Tablo ID numarasi.
                            kgmMaxTrPatterns degerini asamaz.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.4.3.1.2
                            <Unit>  "
        ::= { kgmTrPatternEntry 2 }
--1.4.3.1.3 kgmTrPatternPriority
    kgmTrPatternPriority    OBJECT-TYPE
        SYNTAX              INTEGER (1..255)
        ACCESS              read-write
        STATUS              mandatory
        DESCRIPTION "<Definition> Patternin oncelik seviyesini belirtir. Planlardan
							tetiklenebilecek farkli aksiyonlarin cakismasi durumunda karar
							oncelik parametresine dayali olarak verilecektir. Dusuk deger
							yuksek onceligi temsil eder. 0 degeri onceliklendirilmedigini
							belirtir.
							0: Oncelik atanmamis
							1 - 254: Oncelik seviyesi
							255: Devre disi
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.4.3.1.3
                            <Unit> "
        ::= { kgmTrPatternEntry 3 }
--1.4.3.1.4 kgmTrPatternPlanMode
    kgmTrPatternPlanMode    OBJECT-TYPE
        SYNTAX              INTEGER {
							fixedPlan (1),
							actuated (2),
							centralAdaptive (3),
							flashing (4),
							dark (5),
							localAdaptive (6),
							extendedMode (7)
							}
		ACCESS              read-write
		STATUS              mandatory
		DESCRIPTION "<Definition> 
							FixedPlan	    (1): Multi Plan(sabit sureli), sensorler devre disidir.
												 Faz sureleri timing plan tablsunda belirtilen StaticTime parametresinden alinir.
							Actuated		(2): Kavsagin butun kollarinda sensor
												 bulunmaktadir. Sinyal planindaki butun fazlar acilmakta
												 ve talep olmasi durumunda max sureye kadar calistirilmaktadir.
							CentralAdaptive (3): Bu modda isletilen sure Planlari (Koordinasyon aktifse SplitTable, pasifse TimingPlan) 
												 ve SequenceTable kontrol merkez tarafından belirli araliklarla guncellenmektedir.
												 bagli fazlarin maximum sureye kadar esnetilebildigi dinamik calisma modudur.
							Flash	    	(4): Flasli calisma(Gece flasi gibi)
							Dark		    (5): Tum cikislar kapali.
							LocalAdaptive   (6): Bu modda plan sureleri ve faz siralari, fazlarin isletilip isletilmeyecegi 
												 lokalde cihaz tarafindan uretilmekte ve uygulanmaktadir.
							Extended Mode   (7): Cihazlarin destekledigi ek modlar icin uretici cihaz manueline birakilir.
						<Object Identifier> 1.3.6.1.4.1.59873.4.2.1.4.3.1.4
						<Unit>  "
		::= { kgmTrPatternEntry 4 }
--1.4.3.1.5 kgmTrPatternExtendedMode
    kgmTrPatternExtendedMode OBJECT-TYPE
        SYNTAX               INTEGER (1..255)
		ACCESS               read-write
		STATUS               mandatory
		DESCRIPTION "<Definition> Hangi ek calisma modlarinin desteklendigi ayrintisi icin, uretici cihaz manueline basvurulur.
						<Object Identifier> 1.3.6.1.4.1.59873.4.2.1.4.3.1.5
						<Unit>  "
        ::= { kgmTrPatternEntry 5 }
--1.4.3.1.6 kgmTrPatternSequenceNumber
    kgmTrPatternSequenceNumber OBJECT-TYPE
        SYNTAX                 INTEGER (1..255)
        ACCESS                 read-write
        STATUS                 mandatory
        DESCRIPTION "<Definition> This object is used to locate
							information in the sequenceTable to use with this pattern. This
							value shall not exceed the maxSequences object value.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.4.3.1.6
                            <Unit> "
        ::= { kgmTrPatternEntry 6 }
--1.4.3.1.7 kgmTrPatternSplitNumber
    kgmTrPatternSplitNumber OBJECT-TYPE
        SYNTAX              INTEGER (1..255)
        ACCESS              read-write
        STATUS              mandatory
        DESCRIPTION "<Definition> This object is used to locate information in the
							splitTable to use for this pattern. This value shall
							not exceed the maxSplits object value.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.4.3.1.7
                            <Unit> "
        ::= { kgmTrPatternEntry 7 }
--1.4.3.1.8 kgmTrPatternTimingPlanNumber
    kgmTrPatternTimingPlanNumber OBJECT-TYPE
        SYNTAX              INTEGER (1..255)
        ACCESS              read-write
        STATUS              mandatory
        DESCRIPTION "<Definition> This object is used to locate information in the
							timingPlanTable to use for this plan. This value shall
							not exceed the maxTimingPlan object value.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.4.3.1.8
                            <Unit> "
        ::= { kgmTrPatternEntry 8 }
--1.4.3.1.9 kgmTrPatternCoordStatus
    kgmTrPatternCoordStatus OBJECT-TYPE
        SYNTAX              INTEGER (0..255)
        ACCESS              read-write
        STATUS              mandatory
        DESCRIPTION "<Definition> 0: Yesil dalga uygulanmayacaktir. Yesil dalganin 
							uygulanmayacagi durumlarda, sure planları TiminPlan Tablosundan 
							alınır. 
							1 - 254: Uygulanacak Koordinasyon Parametre Numarasi
							255: Yesil dalga ile ilgili bir degisiklik olmayacak.
							Mevcut duruma devam edilecektir.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.4.3.1.9
                            <Unit>  plan"
        ::= { kgmTrPatternEntry 9 }
--1.4.3.1.10 kgmTrPatternOutputSupervision
    kgmTrPatternOutputSupervision OBJECT-TYPE
        SYNTAX              INTEGER (0..255)
        ACCESS              read-write
        STATUS              mandatory
        DESCRIPTION "<Definition> Sinyal cikislari ariza kontrolunu devreye almak veya
							devre disi birakmak icin kullanilir.
							0: Devre disi
							1: Devrede
							2: Degisiklik yok.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.4.3.1.10
                            <Unit>  "
        ::= { kgmTrPatternEntry 10 }
--1.4.3.1.11 kgmTrPatternSpecParamTableIndex
    kgmTrPatternSpecParamTableIndex OBJECT-TYPE
        SYNTAX              OBJECT IDENTIFIER
        ACCESS              read-write
        STATUS              optional
        DESCRIPTION "<Definition> Uretici ozel bir tablo kullaniyorsa ilgili
                            tablonun referans numarasıdır.
                            <Object Identifier> 1.3.6.1.4.1.59873.4.2.1.4.3.1.11
                            <Unit> "
        ::= { kgmTrPatternEntry 11 }

